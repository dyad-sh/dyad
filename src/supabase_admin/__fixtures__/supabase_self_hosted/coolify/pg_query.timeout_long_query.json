{
  "name": "pg_query.timeout_long_query",
  "request": {
    "method": "POST",
    "path": "/pg/query",
    "auth": "service",
    "body": {
      "query": "select pg_sleep(70), 1 as done"
    }
  },
  "response": {
    "status": 408,
    "body": {
      "error": "Query read timeout",
      "message": "Query read timeout"
    }
  }
}
